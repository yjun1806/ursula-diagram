{
  "name": "@yjun1806/ursula",
  "version": "0.0.0",
  "description": "Draws Mermaid text as inline SVG and terminal text: every diagram type, the same drawing every time, no browser.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./global": "./dist/ursula.global.js"
  },
  "bin": {
    "ursula": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/*-rewrite.test.ts' --exclude 'test/rewrite.test.ts'",
    "dev": "bun src/cli.ts",
    "test:rewrite": "vitest run test/rewrite.test.ts test/route-rewrite.test.ts test/choose-rewrite.test.ts test/rows-rewrite.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
