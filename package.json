{
  "name": "ursula-diagram",
  "version": "0.1.1",
  "description": "Draws Mermaid text as SVG and as terminal text: every diagram type, the same drawing every time, no browser.",
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "sequence-diagram",
    "svg",
    "ascii",
    "terminal",
    "cli",
    "agent-skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjun1806/ursula.git"
  },
  "homepage": "https://github.com/yjun1806/ursula#readme",
  "bugs": {
    "url": "https://github.com/yjun1806/ursula/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./global": "./dist/ursula.global.js"
  },
  "bin": {
    "ursula": "skills/ursula/scripts/ursula.mjs"
  },
  "files": [
    "dist",
    "!dist/cli.js",
    "!dist/cli.d.ts",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/*-rewrite.test.ts' --exclude 'test/rewrite.test.ts'",
    "dev": "bun src/cli.ts",
    "test:rewrite": "vitest run test/rewrite.test.ts test/route-rewrite.test.ts test/choose-rewrite.test.ts test/rows-rewrite.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
